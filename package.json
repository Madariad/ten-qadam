{
  "name": "ten-qadam-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @ten-qadam/web -- --host 0.0.0.0",
    "dev:api": "npm run start:dev -w @ten-qadam/api",
    "build": "npm run build -w @ten-qadam/api && npm run build -w @ten-qadam/web",
    "db:generate": "npm run prisma:generate -w @ten-qadam/api",
    "db:migrate": "npm run prisma:migrate -w @ten-qadam/api",
    "db:seed": "npm run prisma:seed -w @ten-qadam/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "argon2@0.44.0": true
  }
}
